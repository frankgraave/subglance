{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint src --deny-warnings",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "audit:ci": "npm audit --audit-level=high",
    "bundle-budget": "node scripts/bundle-budget.mjs",
    "styleguide": "node scripts/build-styleguide.mjs",
    "test:browser": "npm run build && vitest run --config vitest.browser.config.ts",
    "test:browser:setup": "npx --yes @puppeteer/browsers install chrome-headless-shell@152.0.7977.75"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.103.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.1",
    "axe-core": "4.13.0",
    "jsdom": "^30.1.0",
    "oxlint": "^1.83.0",
    "puppeteer-core": "^25.11.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
